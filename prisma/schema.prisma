generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Declaration {
  id        String   @id @default(uuid())
  certNumber String  @map("cert_number")
  location  String
  seller    Json
  buyer     Json
  husband   Json
  wife      Json
  joint     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("declarations")
}
